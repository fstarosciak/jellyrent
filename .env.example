# JellyRent configuration. Copy to .env, or run `make env` to generate one
# with random secrets. Never commit .env.

# --- central database --------------------------------------------------------
# Owner (superuser) of the database; used only for schema management.
POSTGRES_PASSWORD=change-me-owner
# Least-privilege role used by the API, the worker and the bootstrap job.
APP_DB_PASSWORD=change-me-app

# --- API ---------------------------------------------------------------------
# HS256 signing key for access tokens, at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# JellyRent administrator, created on first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
RENTAL_DEFAULT_HOURS=48

# --- Jellyfin nodes ----------------------------------------------------------
# Administrator created on every node by the bootstrap job.
JELLYFIN_ADMIN_USERNAME=jellyrent-admin
JELLYFIN_ADMIN_PASSWORD=change-me-jellyfin

# Where the catalog sync reads node libraries from: fdw | rest | auto
CATALOG_SOURCE=auto

LOG_LEVEL=INFO
